# Used by docker compose.
# Copy this file to .env and fill Firebase values before building the frontend image.

AICC_KEY=your_google_genai_or_aicc_key

# Leave empty for the Docker one-URL setup. Nginx serves the frontend and proxies /api to backend.
VITE_API_BASE_URL=

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_optional
