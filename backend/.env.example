PORT=8080
DB_DSN="jobhunter_user:jobhunter_password@tcp(127.0.0.1:3306)/jobhunter?charset=utf8mb4&parseTime=True&loc=Local"
AICC_KEY=your_aicc_api_key
AICC_BASE_URL=https://api.ai.cc/v1
AICC_MODEL=gpt-4o-mini

# Firebase project id must match VITE_FIREBASE_PROJECT_ID in frontend/.env
FIREBASE_PROJECT_ID=your-firebase-project-id

# Twilio Verify (SMS number verification) and Messaging (job alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
# Use this only when not using a Messaging Service SID
TWILIO_FROM_NUMBER=
